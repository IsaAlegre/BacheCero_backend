# Copiar este archivo a .env y completar los valores.
DATABASE_URL=postgres://bachecero:bachecero@localhost:5432/bachecero
JWT_SECRET=cambiar-por-una-clave-larga
PORT=3000

# IA real (microservicio bache-cero-ia)
IA_URL=http://localhost:8000

# Sin Cloudinary: fotos en ./uploads
ALMACEN_IMAGENES=local

# Sin consultar OpenStreetMap: calle y barrio de prueba
UBICACION=falsa

# Cuando se usen Cloudinary y Nominatim reales:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NOMINATIM_USER_AGENT=bache-cero-local/0.1 (contacto)
